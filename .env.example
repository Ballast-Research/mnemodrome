# Mnemodrome — Multi-Layer Cognitive Memory System
# Copy this file to .env and configure for your environment
#
# Fastest path: run ./install.sh — it asks three questions and writes this file.
# Manual path: copy to .env, fill in the sections marked REQUIRED, and run
#   docker compose up -d

# =============================================================================
# INSTALL — set by install.sh, or override manually
# =============================================================================

# Where all persistent data lives on the host (Neo4j, Qdrant, Redis, Markdown).
# docker-compose.yml uses bind mounts rooted here: ${DATA_ROOT:-./data}/<service>
# Default: ./data (relative to the install directory)
DATA_ROOT=./data

# Embedding dimension — must match what your embedding model actually produces.
# install.sh probes the live Ollama endpoint and writes the correct value.
# If you change models after install: update this, delete affected Qdrant
# collections, restart Mnemodrome, then re-run bootstrap_vector_embeddings.py.
# nomic-embed-text → 768   mxbai-embed-large → 1024   all-minilm → 384
EMBEDDING_DIM=768

# =============================================================================
# LLM — set by install.sh (Q3), or configure manually
# =============================================================================
# install.sh auto-detects a running Ollama at http://localhost:11434 and
# writes these vars. For manual installs, fill them in below.
#
# NOTE on localhost vs. Docker: the MCP server runs inside Docker. Any URL
# pointing at localhost or 127.0.0.1 on the HOST must be translated to
# http://host.docker.internal:<port> for the container-side vars below.
# install.sh performs this translation automatically.

# Provider (REQUIRED): ollama | openai | anthropic | openai-compatible
LLM_PROVIDER=ollama

# Chat model used for entity extraction and classification (REQUIRED)
CHAT_MODEL=gemma3:4b-it-qat

# API key (REQUIRED for openai/anthropic; leave empty for ollama)
LLM_API_KEY=

# LLM_BASE_URL — unified API base URL for the ollama and openai-compatible
# providers (e.g. http://localhost:11434, or https://openrouter.ai/api/v1).
# install.sh writes this from the detected/entered endpoint.
LLM_BASE_URL=http://host.docker.internal:11434

# Ollama endpoint — container-side URL (host.docker.internal for local Ollama).
# OLLAMA_BASE_URL is a back-compat alias for LLM_BASE_URL; still honored.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_EMBEDDING_HOST=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# CORE DATABASE CONNECTIONS
# =============================================================================
# When using Docker Compose, service names (neo4j, redis, qdrant) resolve
# automatically. Only change these if running services externally.

# Neo4j (Graph Layer — required)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mnemodrome-dev-password
NEO4J_DATABASE=neo4j

# Redis (Cache Layer — optional but recommended)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Qdrant (Vector Layer — optional, enables semantic search)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_ENABLED=true
QDRANT_SIMILARITY_THRESHOLD=0.45

# =============================================================================
# FILE STORAGE (Markdown Memory Files)
# =============================================================================
# MNEMODROME_STORAGE_PATH is the umbrella root. Each memory type lives in
# <umbrella>/<type>: facts, learnings, sessions, graphs, updates, procedures.
# This one line is all most installs need.
MNEMODROME_STORAGE_PATH=./data/mnemodrome

# Optional per-type overrides. Each one overrides ONLY its own folder; the
# other types keep using the umbrella. Set all six and the umbrella is not
# needed (this is how installs created before the umbrella existed work).
# MNEMODROME_FACTS_PATH=./data/mnemodrome/facts
# MNEMODROME_LEARNINGS_PATH=./data/mnemodrome/learnings
# MNEMODROME_SESSIONS_PATH=./data/mnemodrome/sessions
# MNEMODROME_GRAPHS_PATH=./data/mnemodrome/graphs
# MNEMODROME_UPDATES_PATH=./data/mnemodrome/updates
# MNEMODROME_PROCEDURES_PATH=./data/mnemodrome/procedures

# ADVANCED — Obsidian Vault Integration
# You can point the umbrella (or any single type) at a directory inside your
# Obsidian vault so that Mnemodrome memories appear directly in your notes.
# The MCP server writes plain Markdown, which Obsidian reads natively.
#
# Example (Linux/macOS — adjust to your vault location):
# MNEMODROME_STORAGE_PATH=/home/yourname/Documents/MyVault/Mnemodrome
# MNEMODROME_LEARNINGS_PATH=/home/yourname/Documents/MyVault/Inbox/Learnings
#
# When running in Docker you must also bind-mount the vault path into the
# container. In docker-compose.override.yml add something like:
#   services:
#     mcp-server:
#       volumes:
#         - /home/yourname/Documents/MyVault/Mnemodrome:/vault/Mnemodrome
# and set MNEMODROME_STORAGE_PATH=/vault/Mnemodrome.
#
# Note: Obsidian struggles once the facts folder holds tens of thousands of
# files. Use the Memory Browser in the Admin UI (ADMIN_WEB_ENABLED=true,
# then http://localhost:8083/admin/memory) to read the memory at any size.

# =============================================================================
# EVENT LOG (Episodic Memory Layer)
# =============================================================================
# SQLite is the default backend: embedded, zero-config, no extra service.
# It is ideal for a single user or a few agents, though it serializes all
# writes (one writer at a time).
#
# Switch to PostgreSQL for concurrent multi-agent or team deployments where
# multiple SSE clients write events simultaneously (true parallel writes,
# no write-lock contention).  When using PostgreSQL, also start the postgres
# service: docker compose --profile postgres up
#
# Backend selector (sqlite | postgres) - default: sqlite
EVENT_LOG_BACKEND=sqlite

# PostgreSQL connection - two options (uncomment one if EVENT_LOG_BACKEND=postgres):
#
# Option A - single DSN:
# EVENT_LOG_POSTGRES_DSN=postgresql://event_log_user:password@localhost:5432/event_logs
#
# Option B - individual components:
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=event_logs
# PG_USER=event_log_user
# PG_PASSWORD=mnemodrome-dev-password

EVENT_LOG_ENABLED=true
EVENT_LOG_AUTO_CAPTURE=true
EVENT_LOG_RETENTION_DAYS=90
EVENT_LOG_MAX_SIZE_MB=100
EVENT_LOG_SESSION_TIMEOUT_HOURS=4
EVENT_LOG_PERFORMANCE_SLA_MS=50
EVENT_LOG_QUERY_SLA_MS=100
EVENT_LOG_FAIL_LOUD=true

# =============================================================================
# LLM CONFIGURATION — Model-Agnostic
# =============================================================================
# LLM_PROVIDER, CHAT_MODEL, LLM_API_KEY, and OLLAMA_* vars are set in the
# INSTALL section at the top of this file (written by install.sh).
# See the LLM PROVIDER EXAMPLES section below for available options.

# Transport Protocol
# streamable-http = Streamable HTTP — the current MCP standard (spec 2025-03-26+); endpoint /mcp
# sse = Server-Sent Events — DEPRECATED legacy two-endpoint transport (/sse); for older clients only
MCP_TRANSPORT=streamable-http

# GPU Cache Management (Feature 030)
# Set to true on hosts with GPU inference infrastructure
# Requires SSH access to OLLAMA_INFERENCE_HOST for process management
GPU_CACHE_ENABLED=false

# Performance
MCP_CONSTITUTIONAL_TIMEOUT_MS=2000  # Max operation time (constitutional requirement)
MCP_CACHE_ENABLED=true
MCP_CACHE_TTL_SECONDS=300

# =============================================================================
# ADMIN WEB UI CONFIGURATION (Feature 013)
# =============================================================================

# Enable/disable admin web interface (config editor, health, events, and the
# read-only Memory Browser at /admin/memory). Off by default in Docker Compose;
# it binds to 127.0.0.1 only. Put it behind a reverse proxy with TLS to expose it.
ADMIN_WEB_ENABLED=false

# Port for admin web UI (default: 8083)
# Change if port conflict detected
ADMIN_WEB_PORT=8083

# Browser sign-in (form login + session cookie). Scripts can still use
# HTTP Basic auth with the same username/password (curl -u admin:...).
# Secret that signs session cookies. Leave unset to use a random secret per
# process (everyone signs in again after a restart). Example: openssl rand -hex 32
# ADMIN_SESSION_SECRET=
# How long a browser session lasts, in hours (default 12).
# ADMIN_SESSION_TTL_HOURS=12

# Bind address for the admin web UI (default: 127.0.0.1 = this machine only).
# Docker Compose sets 0.0.0.0 inside the container and publishes the port on
# the host's loopback. Do not set 0.0.0.0 on a bare-metal install unless a
# firewall or reverse proxy is in front of it.
# ADMIN_WEB_HOST=127.0.0.1

# Admin credentials for HTTP Basic Auth
# Username (default: admin)
ADMIN_USERNAME=admin

# Password (REQUIRED - no default for security)
# IMPORTANT: Set a strong password (minimum 12 characters recommended)
# Example: Use password manager or: openssl rand -base64 32
ADMIN_PASSWORD=<REPLACE-WITH-SECURE-PASSWORD>

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Runtime-editable via Admin Web UI
LOG_LEVEL=INFO
LOG_FILE=/var/log/mnemodrome/mnemodrome.log
LOG_FORMAT=json  # json or text

# Monitoring
MONITORING_ENABLED=true
METRICS_PORT=9090

# =============================================================================
# SECURITY
# =============================================================================

# SSH Key Paths
SSH_HOST_KEY_PATH=~/.ssh/mnemodrome_host_key
SSH_AUTHORIZED_KEYS_PATH=~/.ssh/mnemodrome_authorized_keys

# Session Settings
SESSION_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=10

# =============================================================================
# LLM PROVIDER EXAMPLES (for switching from default Ollama)
# =============================================================================
# Default is Ollama (set above). To use a different provider,
# change LLM_PROVIDER and CHAT_MODEL above, and set LLM_API_KEY below.

# --- Option 1: Anthropic (Claude) ---
# Uncomment and configure for Claude models:
# LLM_PROVIDER=anthropic
# CHAT_MODEL=claude-3-5-sonnet-20241022
# LLM_API_KEY=sk-ant-your-api-key-here
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=1000
#
# Supported Models:
# - claude-3-5-sonnet-20241022 (recommended for quality)
# - claude-3-5-haiku-20241022 (fast and cost-effective)
# - claude-3-opus-20240229 (maximum capability)
#
# Get API key: https://console.anthropic.com/

# --- Option 2: OpenAI (GPT-4) ---
# Uncomment and configure for OpenAI models:
# LLM_PROVIDER=openai
# CHAT_MODEL=gpt-4
# LLM_API_KEY=sk-your-api-key-here
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=1000
#
# Supported Models:
# - gpt-4 (recommended for quality)
# - gpt-4-turbo (faster, newer)
# - gpt-3.5-turbo (cost-effective)
#
# Get API key: https://platform.openai.com/api-keys

# --- Option 3: Ollama (Local Models - Privacy First) [DEFAULT / RECOMMENDED] ---
# Uncomment and configure for local Ollama models:
# LLM_PROVIDER=ollama
# CHAT_MODEL=gemma3:4b-it-qat
# LLM_BASE_URL=http://localhost:11434
# LLM_TEMPERATURE=0.0
# LLM_MAX_TOKENS=1000
#
# Recommended Models (install via `ollama pull <model>`):
# - gemma3:4b-it-qat (default, ~4.0 GB, publicly pullable, instruction-tuned, verified working)
#   gemma4:e4b-it-qat is a good alternative for users on a recent Ollama version,
#   but it requires a newer Ollama than some Linux distributions package, so gemma3:4b-it-qat is the verified default.
# - qwen2.5:7b (good JSON compliance for structured output)
# - mistral (fast and capable)
#
# Installation:
# 1. Install Ollama: https://ollama.ai
# 2. Pull models: ollama pull gemma3:4b-it-qat && ollama pull nomic-embed-text
# 3. Start server: ollama serve (or run as systemd service)
#
# Benefits:
# - Zero API costs
# - Complete privacy (no data leaves your infrastructure)
# - No internet dependency
# - Full control over model versions

# --- Option 4: OpenAI-Compatible (OpenRouter / xAI Grok / Groq / DeepSeek / vLLM) ---
# Use any provider that speaks the OpenAI chat-completions API.
# Set LLM_BASE_URL to the provider's base URL and LLM_API_KEY to your key.
#
# OpenRouter (access 100+ models via one API key):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# CHAT_MODEL=google/gemma-3-4b-it
# LLM_API_KEY=sk-or-your-openrouter-key-here
#
# xAI Grok:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.x.ai/v1
# CHAT_MODEL=grok-3-mini
# LLM_API_KEY=xai-your-key-here
#
# Groq (ultra-fast inference):
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.groq.com/openai/v1
# CHAT_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_your-groq-key-here
#
# DeepSeek:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# CHAT_MODEL=deepseek-chat
# LLM_API_KEY=sk-your-deepseek-key-here
#
# Self-hosted vLLM:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://my-vllm-server:8000/v1
# CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# LLM_API_KEY=token-abc123
#
# Get keys: https://openrouter.ai  https://x.ai  https://console.groq.com  https://platform.deepseek.com

# -----------------------------------------------------------------------------
# Common LLM Parameters (All Providers)
# -----------------------------------------------------------------------------

# LLM_API_KEY is set in the INSTALL section at top (install.sh writes it).

# LLM_BASE_URL — set in the INSTALL section at top (install.sh writes it).
# Unified base URL for ollama and openai-compatible providers.
# OLLAMA_BASE_URL is a back-compat alias; prefer LLM_BASE_URL for new setups.

# Common parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
# Suppress hidden <think> tokens on Qwen3/DeepSeek-R1 reasoning models.
# Passes extra_body={"think": false} on ollama/openai-compatible calls only.
# Set to "false" to allow thinking mode (useful for multi-step reasoning tasks).
LLM_DISABLE_THINKING=true

# Extraction canary: on startup Mnemodrome proves the configured model actually
# returns entities on a known sentence, before serving. This catches the silent
# reasoning-model trap (a model that emits hidden thinking instead of JSON stores
# nothing on every capture). If the probe is empty, Mnemodrome auto-applies no-think
# and raises the token budget, then retries — a healthy model self-heals. Only a
# model that STILL returns nothing trips the hard-fail.
EXTRACTION_CANARY_ENABLED=true
# If the canary cannot be satisfied even after self-heal, Mnemodrome refuses to
# start rather than silently lose memories. Set true ONLY if you knowingly accept
# degraded extraction (downgrades the hard-fail to a loud warning). Not recommended.
ALLOW_DEGRADED_EXTRACTION=false

# OLLAMA_HOST, OLLAMA_EMBEDDING_HOST, OLLAMA_EMBEDDING_MODEL are set in the
# INSTALL section at top (install.sh translates localhost → host.docker.internal).

# -----------------------------------------------------------------------------
# ADVANCED: Per-role model overrides (optional — default to CHAT_MODEL)
# -----------------------------------------------------------------------------
# Run a separate fine-tuned model for entity/claim extraction and/or entity
# classification while leaving every other LLM call on the default CHAT_MODEL.
# Leave these unset (or empty) and both roles fall back to CHAT_MODEL exactly
# as before — single-model deployments see zero behaviour change.
#
# Example: extraction on a domain-tuned 7B, classification on the fast default.
#   EXTRACTION_MODEL=my-domain-extract-7b
#   CLASSIFICATION_MODEL=my-classify-3b
#
# EXTRACTION_MODEL=        # entity extraction (extract_entities_and_relationships)
#                          # and claim extraction (ClaimExtractionService.extract_claims)
# CLASSIFICATION_MODEL=    # entity classification (classify_entity, classify_entities_batch)

# =============================================================================
# ACT-R COGNITIVE ACTIVATION (Feature 034)
# =============================================================================
# Anderson 1993 base-level activation + Hebbian learning + Bayesian confidence
ACTR_ENABLED=true
ACTR_DECAY_EXPONENT=0.5
ACTR_CONTENT_WEIGHT=0.7
ACTR_ACTIVATION_WEIGHT=0.2
ACTR_HEBBIAN_WEIGHT=0.1
ACTR_HEBBIAN_INCREMENT=0.1
ACTR_CONFIDENCE_DEFAULT=0.8

# =============================================================================
# KNOWLEDGE DEDUPLICATION (Feature 023)
# =============================================================================
DEDUP_AUTO_SKIP_THRESHOLD=0.95
DEDUP_VALIDATION_THRESHOLD=0.90
DEDUP_MAX_VALIDATION_TIME_MS=300
DEDUP_FUZZY_MATCH_THRESHOLD=0.85
DEDUP_ENABLE_GRACEFUL_DEGRADATION=true

# =============================================================================
# CONFLICT DETECTION
# =============================================================================
# Critical entities that get special conflict handling
# Override with comma-separated list of your infrastructure entity names
CRITICAL_ENTITIES=Mnemodrome,Neo4j,Qdrant,Redis,Ollama,mnemodrome-mcp,admin-web,event-log

# Report output directory
CONFLICT_REPORT_DIR=./data/conflict-reports

# =============================================================================
# GPU CACHE MANAGEMENT (optional — for remote Ollama GPU management)
# =============================================================================
# GPU_CACHE_LAYER1_ENABLED=true
# GPU_CACHE_LAYER2_ENABLED=true
# GPU_CACHE_LAYER3_ENABLED=true
# GPU_STALE_RUNNER_THRESHOLD_SECONDS=30
# OLLAMA_INFERENCE_HOST=localhost
# MNEMODROME_SSH_PREFIX=  # e.g., "admin-" for admin-hostname SSH alias pattern

# =============================================================================
# DATA PATHS (Docker Compose volume overrides)
# =============================================================================
# MNEMODROME_DATA_PATH=./data/mnemodrome
# QDRANT_DATA_PATH=./data/qdrant

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# DEVELOPMENT
# =============================================================================
ENVIRONMENT=development
DEBUG=false

# =============================================================================
# HOOK AUTHENTICATION (for Claude Code integration)
# =============================================================================
# MNEMODROME_HOOK_TOKEN=
# PROJECT_CONTEXT_ENDPOINT_ENABLED=true
